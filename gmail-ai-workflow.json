    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $input.item.json;\n\nconsole.log(response);\n\nconst content =\n  response?.choices?.[0]?.message?.content ||\n  response?.data?.choices?.[0]?.message?.content;\n\nif (!content) {\n  return {\n    json: {\n      error: \"No AI response content found\",\n      full_response: response\n    }\n  };\n}\n\nconst cleaned = content\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet data;\n\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  return {\n    json: {\n      error: \"Invalid JSON\",\n      raw: cleaned\n    }\n  };\n}\n\nconst labels = {\n  work: \"Label_3272446732333660500\",\n  finance: \"Label_9122724880040644594\",\n  personal: \"Label_2113930991147229230\",\n  promotion: \"Label_2389672418718472155\",\n  meeting: \"Label_8971484299382553051\",\n  spam: \"Label_8953554111217387453\",\n  urgent: \"Label_5791745347457165281\",\n  default: \"Label_3272446732333660500\"\n};\n\nreturn {\n  json: {\n    ...response,\n    summary: data.summary,\n    category: data.category,\n    priority: data.priority,\n    needs_reply: data.needs_reply,\n    meeting_detected: data.meeting_detected === true || data.meeting_detected === \"true\",\n    meeting_title: data.meeting_title,\n    meeting_date: data.meeting_date,\n    meeting_time: data.meeting_time,\n    meeting_end_time: data.meeting_end_time,\n    confidence: data.confidence,\n    gmail_label:\n      labels[data.category?.toLowerCase()] || labels.default\n  }\n};"
      },
